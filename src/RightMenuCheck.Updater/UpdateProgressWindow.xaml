<Window x:Class="RightMenuCheck.Updater.UpdateProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RightMenuCheck 更新"
        Icon="/RightMenuCheck.Updater;component/Assets/RightMenuCheck.ico"
        Width="540"
        Height="276"
        MinWidth="540"
        MinHeight="276"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6F7"
        Foreground="#17212B"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        FontSize="13">
  <Window.Resources>
    <Style x:Key="ModernProgressBarStyle" TargetType="ProgressBar">
      <Setter Property="Height" Value="8" />
      <Setter Property="Foreground" Value="#087E8B" />
      <Setter Property="Background" Value="#D7DEE1" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ProgressBar">
            <Border Background="{TemplateBinding Background}"
                    CornerRadius="4"
                    SnapsToDevicePixels="True">
              <Grid x:Name="PART_Track">
                <Border x:Name="PART_Indicator"
                        HorizontalAlignment="Left"
                        Background="{TemplateBinding Foreground}"
                        CornerRadius="4" />
              </Grid>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid Margin="30,26,30,24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid Grid.Row="0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="48" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Image Width="44"
             Height="44"
             Source="/RightMenuCheck.Updater;component/Assets/RightMenuCheck.png"
             Stretch="Uniform" />
      <StackPanel Grid.Column="1"
                  Margin="14,0,0,0"
                  VerticalAlignment="Center">
        <TextBlock FontSize="20"
                   FontWeight="SemiBold"
                   Text="正在安装更新" />
        <TextBlock Margin="0,3,0,0"
                   Foreground="#60717D"
                   Text="RightMenuCheck" />
      </StackPanel>
    </Grid>

    <StackPanel Grid.Row="1" Margin="0,24,0,18">
      <TextBlock x:Name="StatusText"
                 FontSize="14"
                 FontWeight="SemiBold"
                 Text="正在启动更新事务…"
                 TextWrapping="Wrap" />
      <TextBlock x:Name="DetailText"
                 MinHeight="20"
                 Margin="0,8,0,0"
                 Foreground="#60717D"
                 Text="新版本通过运行验证后，更新才会完成。"
                 TextWrapping="Wrap" />
    </StackPanel>

    <ProgressBar x:Name="InstallProgress"
                 Grid.Row="2"
                 Minimum="0"
                 Maximum="100"
                 Value="32"
                 Style="{StaticResource ModernProgressBarStyle}" />

    <Grid Grid.Row="3" Margin="0,10,0,0">
      <TextBlock VerticalAlignment="Center"
                 Foreground="#60717D"
                 Text="安装与启动验证" />
      <TextBlock x:Name="PercentText"
                 HorizontalAlignment="Right"
                 VerticalAlignment="Center"
                 Foreground="#087E8B"
                 FontWeight="SemiBold"
                 Text="32%" />
    </Grid>
  </Grid>
</Window>
