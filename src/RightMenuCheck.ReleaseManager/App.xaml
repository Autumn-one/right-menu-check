<Application x:Class="RightMenuCheck.ReleaseManager.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:RightMenuCheck.ReleaseManager.Converters"
             Startup="OnStartup"
             Exit="OnExit"
             ShutdownMode="OnMainWindowClose">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Themes/Controls.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
      <converters:AnnouncementKindLabelConverter x:Key="AnnouncementKindLabelConverter" />
    </ResourceDictionary>
  </Application.Resources>
</Application>
