<Window x:Class="RightMenuCheck.ReleaseManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RightMenuCheck 发布管理器"
        Width="1240"
        Height="780"
        MinWidth="980"
        MinHeight="640"
        WindowStartupLocation="CenterScreen">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="64" />
      <RowDefinition Height="*" />
      <RowDefinition Height="40" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0"
            Background="White"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="0,0,0,1">
      <Grid Margin="24,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Border Width="36"
                Height="36"
                VerticalAlignment="Center"
                Background="{StaticResource AccentBrush}"
                CornerRadius="6">
          <TextBlock HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     FontFamily="Segoe MDL2 Assets"
                     FontSize="18"
                     Foreground="White"
                     Text="&#xE7B8;" />
        </Border>
        <StackPanel Grid.Column="1"
                    Margin="12,0,0,0"
                    VerticalAlignment="Center">
          <TextBlock FontSize="18"
                     FontWeight="SemiBold"
                     Text="RightMenuCheck 发布管理器" />
          <TextBlock Margin="0,2,0,0"
                     Foreground="{StaticResource TextSecondaryBrush}">
            <Run Text="{Binding RepositoryLabel, Mode=OneWay}" />
            <Run Text=" · " />
            <Run Text="{Binding BranchLabel, Mode=OneWay}" />
          </TextBlock>
        </StackPanel>
        <Button Grid.Column="2"
                Width="92"
                Style="{StaticResource AppButtonStyle}"
                IsEnabled="{Binding IsBusy}"
                Click="CancelClick">
          <StackPanel Orientation="Horizontal">
            <TextBlock Margin="0,0,7,0"
                       FontFamily="Segoe MDL2 Assets"
                       Text="&#xE711;" />
            <TextBlock Text="取消操作" />
          </StackPanel>
        </Button>
      </Grid>
    </Border>

    <TabControl Grid.Row="1" Margin="24,0,24,18">
      <TabItem AutomationProperties.Name="发布历史">
        <TabItem.Header>
          <StackPanel Orientation="Horizontal">
            <TextBlock Margin="0,0,8,0"
                       FontFamily="Segoe MDL2 Assets"
                       Text="&#xE81C;" />
            <TextBlock Text="发布历史" />
          </StackPanel>
        </TabItem.Header>
        <Grid Margin="0,18,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" MinWidth="520" />
            <ColumnDefinition Width="18" />
            <ColumnDefinition Width="*" MinWidth="310" />
          </Grid.ColumnDefinitions>
          <Border Style="{StaticResource PaneBorderStyle}">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="54" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>
              <Grid Margin="16,0">
                <TextBlock VerticalAlignment="Center"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Text="GitHub Releases" />
                <Button Width="92"
                        HorizontalAlignment="Right"
                        Style="{StaticResource AppButtonStyle}"
                        IsEnabled="{Binding IsReady}"
                        Click="RefreshReleasesClick">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Margin="0,0,7,0"
                               FontFamily="Segoe MDL2 Assets"
                               Text="&#xE72C;" />
                    <TextBlock Text="刷新" />
                  </StackPanel>
                </Button>
              </Grid>
              <DataGrid Grid.Row="1"
                        Margin="-1,0,-1,-1"
                        BorderThickness="1,1,1,1"
                        AutoGenerateColumns="False"
                        ItemsSource="{Binding Releases}"
                        SelectedItem="{Binding SelectedRelease}">
                <DataGrid.Columns>
                  <DataGridTextColumn Width="135" Header="Tag" Binding="{Binding TagName}" />
                  <DataGridTextColumn Width="*" MinWidth="170" Header="名称" Binding="{Binding Name}" />
                  <DataGridTextColumn Width="155" Header="发布时间" Binding="{Binding PublishedAtUtc, StringFormat={}{0:yyyy-MM-dd HH:mm}}" />
                  <DataGridTextColumn Width="75" Header="资产" Binding="{Binding Assets.Count}" />
                </DataGrid.Columns>
              </DataGrid>
            </Grid>
          </Border>

          <Border Grid.Column="2"
                  Padding="18"
                  Style="{StaticResource PaneBorderStyle}">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <TextBlock FontSize="16"
                         FontWeight="SemiBold"
                         Text="{Binding SelectedRelease.Name, TargetNullValue=请选择一个发布版本}" />
              <TextBlock Grid.Row="1"
                         Margin="0,6,0,0"
                         Foreground="{StaticResource TextSecondaryBrush}"
                         Text="{Binding SelectedRelease.TagName}" />
              <TextBlock Grid.Row="2"
                         Margin="0,18,0,7"
                         Style="{StaticResource FieldLabelStyle}"
                         Text="发布资产" />
              <DataGrid Grid.Row="3"
                        BorderThickness="0"
                        AutoGenerateColumns="False"
                        HeadersVisibility="Column"
                        ItemsSource="{Binding SelectedRelease.Assets}">
                <DataGrid.Columns>
                  <DataGridTextColumn Width="*" Header="文件" Binding="{Binding Name}" />
                  <DataGridTextColumn Width="90" Header="字节" Binding="{Binding SizeBytes, StringFormat=N0}" />
                  <DataGridTextColumn Width="65" Header="下载" Binding="{Binding DownloadCount}" />
                </DataGrid.Columns>
              </DataGrid>
              <StackPanel Grid.Row="4" Margin="0,16,0,0">
                <CheckBox Margin="0,0,0,12"
                          Content="同时删除对应 Git tag"
                          IsChecked="{Binding DeleteTag}" />
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Button Style="{StaticResource AppButtonStyle}"
                          IsEnabled="{Binding CanUseSelectedRelease}"
                          Click="OpenReleaseClick">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Margin="0,0,7,0"
                                 FontFamily="Segoe MDL2 Assets"
                                 Text="&#xE8A7;" />
                      <TextBlock Text="查看" />
                    </StackPanel>
                  </Button>
                  <Button Grid.Column="2"
                          Style="{StaticResource DangerButtonStyle}"
                          IsEnabled="{Binding CanUseSelectedRelease}"
                          Click="DeleteReleaseClick">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Margin="0,0,7,0"
                                 FontFamily="Segoe MDL2 Assets"
                                 Text="&#xE74D;" />
                      <TextBlock Text="删除版本" />
                    </StackPanel>
                  </Button>
                </Grid>
              </StackPanel>
            </Grid>
          </Border>
        </Grid>
      </TabItem>

      <TabItem AutomationProperties.Name="构建发布">
        <TabItem.Header>
          <StackPanel Orientation="Horizontal">
            <TextBlock Margin="0,0,8,0"
                       FontFamily="Segoe MDL2 Assets"
                       Text="&#xE74E;" />
            <TextBlock Text="构建发布" />
          </StackPanel>
        </TabItem.Header>
        <ScrollViewer Margin="0,18,0,0" VerticalScrollBarVisibility="Auto">
          <Grid MaxWidth="820" HorizontalAlignment="Center">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Border Padding="14,11"
                    Background="{StaticResource WarningBackgroundBrush}"
                    BorderBrush="#E8C57D"
                    BorderThickness="1"
                    CornerRadius="5"
                    Visibility="{Binding ShowVersionCompatibilityNotice, Converter={StaticResource BooleanToVisibilityConverter}}">
              <StackPanel Orientation="Horizontal">
                <TextBlock Margin="0,1,9,0"
                           FontFamily="Segoe MDL2 Assets"
                           Foreground="{StaticResource WarningBrush}"
                           Text="&#xE7BA;" />
                <TextBlock Foreground="{StaticResource WarningBrush}"
                           TextWrapping="Wrap"
                           Text="publish.ps1 当前未接收版本参数；发布前会严格核对 build-info.json。" />
              </StackPanel>
            </Border>
            <Grid Grid.Row="1" Margin="0,24,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="160" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock VerticalAlignment="Center"
                         Style="{StaticResource FieldLabelStyle}"
                         Text="版本号" />
              <TextBox Grid.Column="1"
                       AutomationProperties.Name="发布版本号"
                       Text="{Binding PublishVersion, UpdateSourceTrigger=PropertyChanged}" />
            </Grid>
            <Grid Grid.Row="2" Margin="0,16,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="160" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Style="{StaticResource FieldLabelStyle}" Text="发布说明" />
              <TextBox Grid.Column="1"
                       Height="230"
                       AutomationProperties.Name="发布说明"
                       AcceptsReturn="True"
                       TextWrapping="Wrap"
                       VerticalContentAlignment="Top"
                       VerticalScrollBarVisibility="Auto"
                       Text="{Binding ReleaseNotes, UpdateSourceTrigger=PropertyChanged}" />
            </Grid>
            <Grid Grid.Row="3" Margin="160,16,0,0">
              <CheckBox Content="标记为预发布版本" IsChecked="{Binding IsPrerelease}" />
            </Grid>
            <Button Grid.Row="4"
                    Width="150"
                    Margin="0,28,0,0"
                    HorizontalAlignment="Right"
                    Style="{StaticResource PrimaryButtonStyle}"
                    IsEnabled="{Binding IsReady}"
                    Click="PublishClick">
              <StackPanel Orientation="Horizontal">
                <TextBlock Margin="0,0,8,0"
                           FontFamily="Segoe MDL2 Assets"
                           Text="&#xE898;" />
                <TextBlock Text="构建并发布" />
              </StackPanel>
            </Button>
          </Grid>
        </ScrollViewer>
      </TabItem>

      <TabItem AutomationProperties.Name="用户公告">
        <TabItem.Header>
          <StackPanel Orientation="Horizontal">
            <TextBlock Margin="0,0,8,0"
                       FontFamily="Segoe MDL2 Assets"
                       Text="&#xE7F4;" />
            <TextBlock Text="用户公告" />
          </StackPanel>
        </TabItem.Header>
        <Grid Margin="0,18,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.05*" MinWidth="390" />
            <ColumnDefinition Width="18" />
            <ColumnDefinition Width="1.35*" MinWidth="480" />
          </Grid.ColumnDefinitions>
          <Border Style="{StaticResource PaneBorderStyle}">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="54" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>
              <Grid Margin="16,0">
                <TextBlock VerticalAlignment="Center"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Text="公开公告" />
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                  <Button Width="92"
                          Margin="0,0,8,0"
                          Style="{StaticResource AppButtonStyle}"
                          IsEnabled="{Binding IsReady}"
                          Click="NewAnnouncementClick">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Margin="0,0,7,0"
                                 FontFamily="Segoe MDL2 Assets"
                                 Text="&#xE710;" />
                      <TextBlock Text="新建" />
                    </StackPanel>
                  </Button>
                  <Button Width="92"
                          Style="{StaticResource AppButtonStyle}"
                          IsEnabled="{Binding IsReady}"
                          Click="RefreshAnnouncementsClick">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Margin="0,0,7,0"
                                 FontFamily="Segoe MDL2 Assets"
                                 Text="&#xE72C;" />
                      <TextBlock Text="刷新" />
                    </StackPanel>
                  </Button>
                </StackPanel>
              </Grid>
              <DataGrid Grid.Row="1"
                        Margin="-1,0,-1,-1"
                        AutoGenerateColumns="False"
                        ItemsSource="{Binding AnnouncementMessages}"
                        SelectedItem="{Binding SelectedAnnouncement}">
                <DataGrid.Columns>
                  <DataGridTextColumn Width="*" Header="标题" Binding="{Binding Title}" />
                  <DataGridTextColumn Width="95" Header="ID" Binding="{Binding Id}" />
                  <DataGridTextColumn Width="58" Header="修订" Binding="{Binding Revision}" />
                  <DataGridTextColumn Width="85"
                                      Header="类型"
                                      Binding="{Binding Kind, Converter={StaticResource AnnouncementKindLabelConverter}}" />
                </DataGrid.Columns>
              </DataGrid>
            </Grid>
          </Border>

          <Border Grid.Column="2"
                  Padding="20"
                  Style="{StaticResource PaneBorderStyle}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="150" />
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="公告 ID" />
                    <TextBox IsReadOnly="{Binding IsEditingAnnouncement}"
                             AutomationProperties.Name="公告 ID"
                             Text="{Binding AnnouncementId, UpdateSourceTrigger=PropertyChanged}" />
                  </StackPanel>
                  <StackPanel Grid.Column="2">
                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="类型" />
                    <ComboBox ItemsSource="{Binding AnnouncementKinds}"
                              AutomationProperties.Name="公告类型"
                              SelectedValuePath="Value"
                              SelectedValue="{Binding AnnouncementKind}">
                      <ComboBox.ItemTemplate>
                        <DataTemplate>
                          <TextBlock Text="{Binding Label}" />
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                  </StackPanel>
                </Grid>
                <StackPanel Grid.Row="1" Margin="0,14,0,0">
                  <TextBlock Style="{StaticResource FieldLabelStyle}" Text="标题" />
                  <TextBox AutomationProperties.Name="公告标题"
                           Text="{Binding AnnouncementTitle, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Grid.Row="2" Margin="0,14,0,0">
                  <TextBlock Style="{StaticResource FieldLabelStyle}" Text="正文" />
                  <TextBox Height="128"
                           AcceptsReturn="True"
                           AutomationProperties.Name="公告正文"
                           TextWrapping="Wrap"
                           VerticalContentAlignment="Top"
                           VerticalScrollBarVisibility="Auto"
                           Text="{Binding AnnouncementBody, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <Grid Grid.Row="3" Margin="0,14,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="开始时间（UTC）" />
                    <TextBox AutomationProperties.Name="公告开始时间 UTC"
                             Text="{Binding AnnouncementStartsAtUtc, UpdateSourceTrigger=PropertyChanged}" />
                  </StackPanel>
                  <StackPanel Grid.Column="2">
                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="结束时间（UTC，可留空）" />
                    <TextBox AutomationProperties.Name="公告结束时间 UTC"
                             Text="{Binding AnnouncementEndsAtUtc, UpdateSourceTrigger=PropertyChanged}" />
                  </StackPanel>
                </Grid>
                <Grid Grid.Row="4" Margin="0,14,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="最低版本（可留空）" />
                    <TextBox AutomationProperties.Name="公告最低版本"
                             Text="{Binding MinimumVersion, UpdateSourceTrigger=PropertyChanged}" />
                  </StackPanel>
                  <StackPanel Grid.Column="2">
                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="最高版本（可留空）" />
                    <TextBox AutomationProperties.Name="公告最高版本"
                             Text="{Binding MaximumVersion, UpdateSourceTrigger=PropertyChanged}" />
                  </StackPanel>
                </Grid>
                <Separator Grid.Row="5" Margin="0,20,0,16" Background="{StaticResource BorderBrush}" />
                <Grid Grid.Row="6">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <Button Width="112"
                          Style="{StaticResource DangerButtonStyle}"
                          Visibility="{Binding IsEditingAnnouncement, Converter={StaticResource BooleanToVisibilityConverter}}"
                          IsEnabled="{Binding CanWithdrawAnnouncement}"
                          Click="WithdrawAnnouncementClick">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Margin="0,0,7,0"
                                 FontFamily="Segoe MDL2 Assets"
                                 Text="&#xE74D;" />
                      <TextBlock Text="撤下公告" />
                    </StackPanel>
                  </Button>
                  <Button Grid.Column="2"
                          Width="126"
                          Style="{StaticResource PrimaryButtonStyle}"
                          IsEnabled="{Binding IsReady}"
                          Click="SaveAnnouncementClick">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Margin="0,0,7,0"
                                 FontFamily="Segoe MDL2 Assets"
                                 Text="&#xE74E;" />
                      <TextBlock Text="{Binding AnnouncementSaveLabel}" />
                    </StackPanel>
                  </Button>
                </Grid>
              </Grid>
            </ScrollViewer>
          </Border>
        </Grid>
      </TabItem>
    </TabControl>

    <Border Grid.Row="2"
            Background="#E9EEEE"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="0,1,0,0">
      <Grid Margin="24,0">
        <ProgressBar Width="88"
                     Height="3"
                     HorizontalAlignment="Left"
                     VerticalAlignment="Top"
                     IsIndeterminate="True"
                     Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
        <TextBlock VerticalAlignment="Center"
                   Foreground="{StaticResource TextSecondaryBrush}"
                   Text="{Binding StatusText}" />
      </Grid>
    </Border>
  </Grid>
</Window>
