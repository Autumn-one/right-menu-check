<Window x:Class="RightMenuCheck.App.UpdateRequiredWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RightMenuCheck 更新"
        Icon="Assets/RightMenuCheck.ico"
        Width="520"
        Height="330"
        MinWidth="520"
        MinHeight="330"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
  <Grid Margin="32,26">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Orientation="Horizontal">
      <Image Width="42"
             Height="42"
             Source="/RightMenuCheck.App;component/Assets/RightMenuCheck.png"
             Stretch="Uniform" />
      <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
        <TextBlock Text="发现新版本"
                   FontSize="20"
                   FontWeight="SemiBold" />
        <TextBlock x:Name="VersionText"
                   Margin="0,3,0,0"
                   Foreground="{StaticResource TextSecondaryBrush}" />
      </StackPanel>
    </StackPanel>

    <TextBlock Grid.Row="1"
               Margin="0,24,0,0"
               FontSize="14"
               Text="需要完成更新后继续使用。更新包已通过镜像下载，并完成签名与完整性验证。"
               TextWrapping="Wrap" />

    <TextBlock x:Name="StatusText"
               Grid.Row="2"
               Margin="0,20,0,0"
               Foreground="{StaticResource TextSecondaryBrush}"
               Text="更新已准备好。"
               TextWrapping="Wrap" />

    <ProgressBar x:Name="UpdateProgress"
                 Grid.Row="3"
                 Height="5"
                 Margin="0,0,0,18"
                 Minimum="0"
                 Maximum="100"
                 Value="30"
                 Foreground="{StaticResource AccentBrush}"
                 Background="#D7DEE1" />

    <Button x:Name="UpdateButton"
            Grid.Row="4"
            Width="128"
            Height="38"
            HorizontalAlignment="Right"
            Style="{StaticResource PrimaryToolbarButtonStyle}"
            Click="UpdateButton_Click"
            Content="立即更新" />
  </Grid>
</Window>
